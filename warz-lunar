local stateConnection = FishingState.OnClientEvent:Connect(function(data)
    if typeof(data) ~= "table" or typeof(data.phase) ~= "string" then return end
    
    if data.phase == "cast" then
        State.currentPhase = "cast"
        State.activeCastId = data.castId
        State.reelFired = false
        State.reelData = nil
        State.statusText = "กำลังเหวี่ยงเบ็ด... รอปลากินเหยื่อ"
        
    elseif data.phase == "reel" then
        State.currentPhase = "reel"
        State.activeCastId = data.castId
        State.reelData = data
        State.reelFired = false
        State.statusText = "ปลากินเบ็ดแล้ว! กำลังตวัดอัตโนมัติ..."
        
    elseif data.phase == "result" then
        State.currentPhase = "result"
        State.reelData = nil
        State.reelFired = false
        
        if data.ok then
            State.totalCatches = State.totalCatches + 1
            local rewards = data.rewards or { { name = data.name or data.itemId, qty = data.qty or 1 } }
            local list = {}
            for _, r in ipairs(rewards) do
                table.insert(list, string.format("%s ×%d", tostring(r.name or r.itemId or "ปลา"), tonumber(r.qty) or 1))
            end
            State.lastLoot = table.concat(list, ", ")
            State.statusText = "ตกสำเร็จ! ได้: " .. State.lastLoot
        else
            State.statusText = "ปลาหลุด / ไม่ติดเบ็ด (" .. tostring(data.message or "Miss") .. ")"
        end
        
        task.delay(2.6, function()
            if State.currentPhase == "result" then
                State.currentPhase = "idle"
            end
        end)
        
    elseif data.phase == "cancel" then
        State.currentPhase = "idle"
        State.reelData = nil
        State.reelFired = false
        State.statusText = "การตกปลาถูกยกเลิก"
    end
end)

-- Precision Reel Monitor (Runs on Heartbeat)
local reelConnection = RunService.Heartbeat:Connect(function()
    if not State.enabled then return end
    if State.currentPhase == "reel" and State.reelData and not State.reelFired then
        local data = State.reelData
        local now = Workspace:GetServerTimeNow()
        
        local marker = (now - data.biteAt) * data.speed % 2
        if marker < 0 then marker = marker + 2 end
        if marker >= 1 then marker = 2 - marker end
        
        local diff = math.abs(marker - data.zoneCenter)
        local safeZone = (data.zoneWidth or 0.3) * 0.38
        
        if diff <= safeZone or (now >= (data.deadline or 0) - 0.15) then
            State.reelFired = true
            FishingReel:FireServer(data.castId, now)
            State.currentPhase = "waiting_result"
            State.statusText = "ตวัดเบ็ดสำเร็จ! กำลังดึงปลา..."
        end
    end
end)

-- Helper: Auto Stash All Items to Warehouse
local function performAutoStash()
    if os.clock() - State.lastStashTime < 3.0 then return end
    State.lastStashTime = os.clock()
    
    -- Ensure bait is kept in slot 5 so BagAllToStash doesn't dump the active bait
    local _, bSlot = countBait(State.selectedBait)
    if bSlot and bSlot >= 9 then
        SwapBagSlot:FireServer(bSlot, 5)
        task.wait(0.3)
    end
    
    State.statusText = "📦 กระเป๋าเต็ม! กำลังเก็บของเข้าคลังทั้งหมด..."
    BagAllToStash:FireServer()
    task.wait(0.8)
    State.statusText = "เก็บของเข้าคลังเรียบร้อย! พร้อมตกปลาต่อ"
end

-- Main Automation Cycle
_G.LunarHubRunning = true
task.spawn(function()
    while _G.LunarHubRunning do
        task.wait(0.4)
        
        if State.enabled then
            if not State.savedSpot then
                State.statusText = "กรุณากด 'เซ็ตจุดตกปลา' ก่อนเริ่ม"
            else
                local char = LocalPlayer.Character
                local hrp = char and char:FindFirstChild("HumanoidRootPart")
                
                if hrp then
                    local dist = (Vector3.new(hrp.Position.X, 0, hrp.Position.Z) - Vector3.new(State.savedSpot.playerPos.X, 0, State.savedSpot.playerPos.Z)).Magnitude
                    
                    if dist > State.maxDistanceTolerance then
                        -- Manual walking only: strictly no fly, no teleport
                        State.statusText = string.format("กรุณาเดินไปยังจุดตกปลา (ห่าง %.1f m)", dist)
                    else
                        -- Check Auto Stash condition
                        if State.autoStash then
                            local emptySlots, _, weight, weightMax = getBackpackCapacity()
                            if emptySlots <= 2 or weight >= (weightMax - 1) then
                                performAutoStash()
                            end
                        end
                        
                        -- Auto Fishing Cycle
                        if State.currentPhase == "idle" then
                            -- 1. Check Bait count
                            local bCount, bSlot = countBait(State.selectedBait)
                            if bCount <= 0 then
                                if State.autoBuyBait and not State.isBuying then
                                    State.isBuying = true
                                    State.statusText = "เหยื่อหมด! กำลังซื้อเหยื่ออัตโนมัติ..."
                                    local money = getMoney()
                                    local baitPrice = 200
                                    for _, b in ipairs(Baits) do
                                        if b.id == State.selectedBait then baitPrice = b.price break end
                                    end
                                    
                                    if money >= baitPrice then
                                        BuyItem:FireServer(State.selectedBait, State.buyAmount)
                                        task.wait(0.65)
                                        bCount, bSlot = countBait(State.selectedBait)
                                        State.isBuying = false
                                        if bCount <= 0 then
                                            State.statusText = "ซื้อเหยื่อไม่สำเร็จ (เงินไม่พอหรือกระเป๋าเต็ม)"
                                        end
                                    else
                                        State.isBuying = false
                                        State.statusText = "เงินไม่พอซื้อเหยื่อ (" .. money .. " ฿)"
                                    end
                                else
                                    State.statusText = "เหยื่อหมด! กรุณาเปิด Auto Buy หรือเติมเหยื่อ"
                                end
                            else
                                -- 2. Check Rod
                                local rSlot = findItemSlot(State.selectedRod)
                                if not rSlot then
                                    State.statusText = "ไม่พบเบ็ด '" .. State.selectedRod .. "' ในตัว"
                                else
                                    -- If rod is in backpack storage (> 6), move to hotbar slot 6
                                    if rSlot > 6 then
                                        State.statusText = "กำลังย้ายเบ็ดมาใส่ช่องมือ (Slot 6)..."
                                        SwapBagSlot:FireServer(rSlot, 6)
                                        task.wait(0.35)
                                        rSlot = 6
                                    end
                                    
                                    -- Equip rod to hand
                                    local active = tonumber(LocalPlayer:GetAttribute("CSGO_ActiveSlot")) or 0
                                    if active ~= rSlot then
                                        SwitchWeaponRequest:FireServer(rSlot)
                                        task.wait(0.35)
                                    end
                                    
                                    -- Re-verify bait slot
                                    _, bSlot = countBait(State.selectedBait)
                                    if bSlot then
                                        State.statusText = "กำลังเหวี่ยงเบ็ดไปที่จุดตกปลา..."
                                        FishingStart:FireServer(rSlot, bSlot, State.savedSpot.castPos)
                                        task.wait(1.0)
                                    end
                                end
                            end
                        end
                    end
                end
            end
        end
    end
end)

