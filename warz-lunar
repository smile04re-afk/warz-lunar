-- UI Live Updater Loop
task.spawn(function()
    while ScreenGui.Parent and _G.LunarHubRunning do
        task.wait(0.35)
        
        -- Distance update
        local char = LocalPlayer.Character
        local hrp = char and char:FindFirstChild("HumanoidRootPart")
        if hrp and State.savedSpot then
            local dist = (Vector3.new(hrp.Position.X, 0, hrp.Position.Z) - Vector3.new(State.savedSpot.playerPos.X, 0, State.savedSpot.playerPos.Z)).Magnitude
            if dist <= State.maxDistanceTolerance then
                distBadge.Text = string.format("ระยะห่าง: %.1f m [✓ อยู่ตรงจุดตกปลา]", dist)
                distBadge.TextColor3 = Color3.fromRGB(52, 211, 153)
            else
                distBadge.Text = string.format("ระยะห่าง: %.1f m [🏃 กรุณาเดินไปยังจุด]", dist)
                distBadge.TextColor3 = Color3.fromRGB(248, 113, 113)
            end
        end
        
        -- Bait & Money update
        local bCount = countBait(State.selectedBait)
        local money = getMoney()
        local baitName = State.selectedBait == "BaitSpider" and "เหยื่อแมงมุม" or "เหยื่อ Chubby"
        liveBaitInfo.Text = string.format("%s: %d ชิ้น | เงินคงเหลือ: %s ฿", baitName, bCount, tostring(money))
        
        -- Backpack capacity update
        local emptySlots, filledSlots, weight, weightMax = getBackpackCapacity()
        bagCapacityLabel.Text = string.format("ช่องในกระเป๋า: ว่าง %d ช่อง (มีของ %d) | น้ำหนัก: %.1f / %.1f", emptySlots, filledSlots, weight, weightMax)
        if emptySlots <= 2 then
            bagCapacityLabel.TextColor3 = Color3.fromRGB(248, 113, 113)
        else
            bagCapacityLabel.TextColor3 = Color3.fromRGB(148, 163, 184)
        end
        
        -- Status & Stats
        statusLabel.Text = "สถานะ: " .. State.statusText
        statsLabel.Text = string.format("ตกได้สำเร็จ: %d ครั้ง | ได้ล่าสุด: %s", State.totalCatches, State.lastLoot)
    end
end)

