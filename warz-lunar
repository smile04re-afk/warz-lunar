-- Inventory / State Reader via App Hook
local appStateFunc = nil
pcall(function()
    local Fishing = require(LocalPlayer.PlayerScripts.Client.world.Fishing)
    local upvals = getupvalues(Fishing.Build)
    for _, v in pairs(upvals) do
        if typeof(v) == "function" then
            local ok, r = pcall(v)
            if ok and typeof(r) == "table" and r.profile ~= nil then
                appStateFunc = v
                break
            end
        end
    end
end)

local function getProfile()
    if appStateFunc then
        local ok, s = pcall(appStateFunc)
        if ok and s and s.profile then
            return s.profile
        end
    end
    return nil
end

local function getBackpack()
    local profile = getProfile()
    return profile and profile.Backpack
end

local function getBackpackSlots()
    local bp = getBackpack()
    return (bp and bp.Slots) or {}
end

local function getMoney()
    local profile = getProfile()
    return (profile and profile.Money) or 0
end

local function findItemSlot(targetId)
    local slots = getBackpackSlots()
    for s = 1, 6 do
        if slots[s] and slots[s].ItemId == targetId then
            return s
        end
    end
    for s, item in pairs(slots) do
        if item.ItemId == targetId then
            return s
        end
    end
    return nil
end

local function countBait(targetBaitId)
    local slots = getBackpackSlots()
    local total = 0
    local firstSlot = nil
    for s, item in pairs(slots) do
        if item.ItemId == targetBaitId then
            total = total + (item.Quantity or 1)
            if not firstSlot then
                firstSlot = s
            end
        end
    end
    return total, firstSlot
end

local function getBackpackCapacity()
    local bp = getBackpack()
    if not bp then return 100, 0, 0, 100 end
    local emptySlots = 0
    local filledSlots = 0
    local slots = bp.Slots or {}
    for s = 9, (bp.Size or 108) do
        local it = slots[s]
        if not it or it.ItemId == "" or it.ItemId == nil then
            emptySlots = emptySlots + 1
        else
            filledSlots = filledSlots + 1
        end
    end
    return emptySlots, filledSlots, bp.Weight or 0, bp.WeightMax or 120
end

