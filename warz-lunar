-- Water detection & cast calculation
local function calculateCastTarget()
    local char = LocalPlayer.Character
    local hrp = char and char:FindFirstChild("HumanoidRootPart")
    if not hrp then return nil end

    local cam = Workspace.CurrentCamera
    local look = (cam and cam.CFrame.LookVector) or hrp.CFrame.LookVector
    local startPos = hrp.Position + Vector3.new(0, 1.5, 0)

    -- 1. Raycast towards water
    local rp = RaycastParams.new()
    rp.FilterDescendantsInstances = { char, VisualFolder }
    rp.FilterType = Enum.RaycastFilterType.Exclude
    rp.IgnoreWater = false

    local castDir = (look * 30 - Vector3.new(0, 14, 0)).Unit * 50
    local hit = Workspace:Raycast(startPos, castDir, rp)
    if hit and hit.Material == Enum.Material.Water then
        return hit.Position
    end

    local hitDirect = Workspace:Raycast(startPos, look * 45, rp)
    if hitDirect and hitDirect.Material == Enum.Material.Water then
        return hitDirect.Position
    end

    -- 2. Search Terrain water voxels
    local terrain = Workspace:FindFirstChildOfClass("Terrain")
    if terrain then
        local center = hrp.Position + look * 20
        local region = Region3.new(center - Vector3.new(28, 16, 28), center + Vector3.new(28, 16, 28)):ExpandToGrid(4)
        local ok, materials = pcall(function() return terrain:ReadVoxels(region, 4) end)
        if ok and materials then
            local minBound = region.CFrame.Position - region.Size / 2
            local size = materials.Size
            local bestPos = nil
            local bestDist = 9999
            for x = 1, size.X do
                for y = 1, size.Y do
                    for z = 1, size.Z do
                        if materials[x][y][z] == Enum.Material.Water then
                            local wPos = minBound + Vector3.new((x - 0.5) * 4, (y - 0.5) * 4, (z - 0.5) * 4)
                            local dist = (wPos - hrp.Position).Magnitude
                            if dist >= 8 and dist < bestDist then
                                bestDist = dist
                                bestPos = wPos
                            end
                        end
                    end
                end
            end
            if bestPos then
                return bestPos
            end
        end
    end

    return hrp.Position + look * 25 - Vector3.new(0, 4, 0)
end

